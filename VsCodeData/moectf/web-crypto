COMMON_IV = base64.b64decode("bW9lY3RmMjAyNml2")

def try_decrypt(enc_b64: str, sid: str):
    """尝试用 sid 解密，成功返回学生信息字典，否则抛出异常"""
    key = hashlib.sha256(sid.encode()).digest()
    raw = base64.b64decode(enc_b64)
    ciphertext = raw[:-16]
    tag = raw[-16:]
    cipher = AES.new(key, AES.MODE_GCM, nonce=COMMON_IV)
    plaintext = cipher.decrypt_and_verify(ciphertext, tag)
    student = json.loads(plaintext.decode())
    if student.get("学号") != sid:
        raise ValueError("学号不匹配")
    return student

def worker(segment):
    """
    处理一个学号段 [start, end)
    返回该段内找到的所有学生信息，字典 {学号: 学生信息}
    """
    start, end = segment
    found = {}
    for i in range(start, end):
        sid = f"{i:08d}"
        # 尝试所有密文，直到找到该学号的记录
        for enc in ENCRYPTED_DATA:
            try:
                student = try_decrypt(enc, sid)
                found[sid] = student
                print(f"[进程 {os.getpid()}] 找到学号 {sid}")
                break   # 找到后立即跳出内层循环
            except Exception:
                continue
        # 可选：如果已找到所有记录，提前结束（但记录数未知，可忽略）
    return found

def main():
    total_sids = 100_000_000
    num_workers = cpu_count()   # 使用所有 CPU 核心
    step = total_sids // num_workers
    segments = [(i * step, (i + 1) * step) for i in range(num_workers)]
    segments[-1] = (segments[-1][0], total_sids)  # 确保末尾覆盖到 99999999

    print(f"启动 {num_workers} 个进程，每个进程负责约 {step} 个学号...")
    with Pool(processes=num_workers) as pool:
        results = pool.map(worker, segments)

    # 合并所有结果
    all_found = {}
    for res in results:
        all_found.update(res)

    print(f"\n共找到 {len(all_found)} 条成绩记录：")
    for sid, info in all_found.items():
        print(f"{sid}: {info}")

if __name__ == "__main__":
    main()